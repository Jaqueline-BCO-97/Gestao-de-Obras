# Copie para .env e preencha com a connection string do seu projeto Supabase
# cp .env.example .env
# Supabase Dashboard > Project Settings > Database > Connection string > URI (modo Pooler)

PORT=3000
DATABASE_URL=postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true
