# Copie para .env e preencha com as connection strings do seu projeto Supabase
# cp .env.example .env
# DATABASE_URL com pgbouncer=true na porta 6543 faz o Prisma enviar comandos extras e deixa o sistema mais lento.
# Para desenvolvimento e demonstração, configure DATABASE_URL com a conexão direta (porta 5432); ela aceita poucas conexões simultâneas.
# DIRECT_URL: Shared pooler em modo session (porta 5432), para migrations do Prisma.

PORT=3000
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[SUA-SENHA]@[POOLER-HOST]:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[SUA-SENHA]@[POOLER-HOST]:5432/postgres
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
# Só use true apontando para um banco descartável de demonstração.
OBRAMASTER_DEMO_SEED=false
# Preencha credenciais de integração apenas no .env local/ambiente seguro.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MERCADO_PAGO_ACCESS_TOKEN_TEST=
MERCADO_PAGO_WEBHOOK_SECRET=
