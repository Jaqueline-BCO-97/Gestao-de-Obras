// Gera o cliente Prisma usado pelo backend.
generator client {
  // Usa o cliente oficial para JavaScript.
  provider = "prisma-client-js"
}

// Configura a conexão PostgreSQL sem executar alterações no banco.
datasource db {
  // Define PostgreSQL como banco de dados.
  provider = "postgresql"
  // Lê a conexão da variável DATABASE_URL.
  url      = env("DATABASE_URL")
}

// Representa uma empresa que mantém usuários, obras e serviços.
model Empresa {
  // Identificador UUID criado automaticamente.
  id           String        @id @default(uuid())
  // Nome apresentado para a empresa.
  nome         String
  // Data de criação automática do registro.
  criadoEm     DateTime      @default(now())
  // Usuários que pertencem à empresa.
  usuarios     Usuario[]
  // Obras da empresa.
  obras        Obra[]
  // Funcionários cadastrados na empresa.
  funcionarios Funcionario[]
  // Eventos associados à empresa.
  eventos      ObraEvento[]
  // Contratos associados à empresa.
  contratos    Contrato[]
  // Preços de serviços cadastrados pela empresa.
  tabelasPreco TabelaPreco[]
  convites     Convite[]
}

// Representa uma pessoa que acessa o sistema.
model Usuario {
  // Identificador UUID criado automaticamente.
  id               String           @id @default(uuid())
  // Empresa à qual o usuário pertence.
  empresaId        String
  // Relação obrigatória com a empresa.
  empresa          Empresa          @relation(fields: [empresaId], references: [id])
  // Nome completo do usuário.
  nome             String
  // Endereço de e-mail exclusivo para login.
  email            String           @unique
  // Hash da senha armazenado com segurança.
  senhaHash        String
  // Perfil de acesso do usuário.
  tipo             TipoUsuario
  // Telefone de contato opcional.
  telefone         String?
  // Data de criação automática do registro.
  criadoEm         DateTime         @default(now())
  // Obras em que este usuário é cliente.
  obrasComoCliente Obra[]           @relation("ObraCliente")
  // Eventos criados por este usuário.
  eventos          ObraEvento[]
  // Escalas alteradas por este usuário.
  escalasAlteradas ObraEscala[]     @relation("EscalaAlteradaPor")
  // Cadastro de funcionário ligado opcionalmente a este login.
  funcionario      Funcionario?
  // Aceites de contrato feitos por este usuário.
  contratosAceitos ContratoAceite[]
  // Pagamentos iniciados por este usuário.
  pagamentos       Pagamento[]
  convitesCriados  Convite[]        @relation("ConviteCriadoPor")
}

// Representa uma obra pertencente a uma empresa.
model Obra {
  // Identificador UUID criado automaticamente.
  id                    String       @id @default(uuid())
  // Empresa proprietária da obra.
  empresaId             String
  // Relação obrigatória com a empresa.
  empresa               Empresa      @relation(fields: [empresaId], references: [id])
  // Nome ou título da obra.
  nome                  String
  // Descrição opcional da obra.
  descricao             String?
  // Endereço opcional da obra.
  endereco              String?
  // Cliente associado opcionalmente a um usuário.
  clienteId             String?
  // Relação do cliente com o nome definido para esta associação.
  cliente               Usuario?     @relation("ObraCliente", fields: [clienteId], references: [id])
  // Estado atual da obra.
  status                StatusObra   @default(AGENDADA)
  // Valor total da obra, inicialmente zero.
  valorTotal            Decimal      @default(0) @db.Decimal(12, 2)
  // Data e hora previstas para começar.
  agendadaPara          DateTime?
  // Prazo final planejado.
  prazoFinal            DateTime?
  // Momento em que foi solicitada a conferência de conclusão.
  conclusaoSolicitadaEm DateTime?
  // Momento em que a conclusão foi confirmada.
  conclusaoConfirmadaEm DateTime?
  // Data de criação automática do registro.
  criadoEm              DateTime     @default(now())
  // Histórico de escalas da obra.
  escalas               ObraEscala[]
  // Eventos da linha do tempo.
  eventos               ObraEvento[]
  // Parcelas de pagamento da obra.
  parcelas              Parcela[]
  // Tentativas de pagamento associadas às parcelas desta obra.
  pagamentos            Pagamento[]
  // Contrato opcional da obra.
  contrato              Contrato?
  convites              Convite[]
}

// Representa um profissional associado a uma empresa.
model Funcionario {
  // Identificador UUID criado automaticamente.
  id        String           @id @default(uuid())
  // Empresa que emprega ou contrata o profissional.
  empresaId String
  // Relação obrigatória com a empresa.
  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  // Nome completo do profissional.
  nome      String
  // Função ou especialidade profissional.
  funcao    String
  // Nível de responsabilidade na equipe.
  nivel     NivelFuncionario
  // Telefone opcional do profissional.
  telefone  String?
  // Indica se o profissional está ativo.
  ativo     Boolean          @default(true)
  // Login opcional ligado ao cadastro do profissional.
  usuarioId String?          @unique
  // Relação opcional com o usuário de login.
  usuario   Usuario?         @relation(fields: [usuarioId], references: [id])
  // Data de criação automática do registro.
  criadoEm  DateTime         @default(now())
  // Histórico de escalas deste profissional.
  escalas   ObraEscala[]

  // Acelera consultas de funcionários por empresa.
  @@index([empresaId])
}

// Convite de uso único para vincular clientes e gerentes a uma obra.
model Convite {
  id          String      @id @default(uuid())
  empresaId   String
  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  obraId      String
  obra        Obra        @relation(fields: [obraId], references: [id])
  criadoPorId String
  criadoPor   Usuario     @relation("ConviteCriadoPor", fields: [criadoPorId], references: [id])
  tipo        TipoConvite
  nome        String
  email       String
  funcao      String?
  tokenHash   String      @unique
  expiraEm    DateTime
  usadoEm     DateTime?
  criadoEm    DateTime    @default(now())

  @@index([empresaId, email])
}

// Registra cada período de alocação de um funcionário numa obra.
model ObraEscala {
  // Identificador UUID criado automaticamente.
  id            String      @id @default(uuid())
  // Obra à qual a escala pertence.
  obraId        String
  // Relação obrigatória com a obra.
  obra          Obra        @relation(fields: [obraId], references: [id])
  // Funcionário alocado.
  funcionarioId String
  // Relação obrigatória com o funcionário.
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])
  // Início do período de escala, por padrão agora.
  dataInicio    DateTime    @default(now())
  // Fim opcional do período de escala.
  dataFim       DateTime?
  // Usuário que alterou a escala.
  alteradoPorId String
  // Relação obrigatória com o usuário autor da alteração.
  alteradoPor   Usuario     @relation("EscalaAlteradaPor", fields: [alteradoPorId], references: [id])
  // Motivo opcional da alteração.
  motivo        String?

  // Acelera consultas de escalas por obra.
  @@index([obraId])
}

// Guarda os acontecimentos exibidos na linha do tempo da obra.
model ObraEvento {
  // Identificador UUID criado automaticamente.
  id                 String     @id @default(uuid())
  // Obra relacionada ao evento.
  obraId             String
  // Relação obrigatória com a obra.
  obra               Obra       @relation(fields: [obraId], references: [id])
  // Empresa relacionada ao evento.
  empresaId          String
  // Relação obrigatória com a empresa.
  empresa            Empresa    @relation(fields: [empresaId], references: [id])
  // Usuário que registrou o evento.
  usuarioId          String
  // Relação obrigatória com o autor.
  usuario            Usuario    @relation(fields: [usuarioId], references: [id])
  // Categoria padronizada do evento.
  tipo               TipoEvento
  // Texto descritivo do acontecimento.
  descricao          String
  // Endereço opcional de uma foto associada.
  fotoUrl            String?
  // Define se o cliente pode ver o evento.
  visivelParaCliente Boolean    @default(true)
  // Data de criação automática do evento.
  criadoEm           DateTime   @default(now())

  // Acelera listagem cronológica dos eventos de uma obra.
  @@index([obraId, criadoEm])
  // Acelera consultas de eventos por empresa.
  @@index([empresaId])
}

// Representa uma parcela cobrada em uma obra.
model Parcela {
  // Identificador UUID criado automaticamente.
  id                 String          @id @default(uuid())
  // Obra à qual a parcela pertence.
  obraId             String
  // Relação obrigatória com a obra.
  obra               Obra            @relation(fields: [obraId], references: [id])
  // Número sequencial da parcela na obra.
  numero             Int
  // Valor monetário da parcela.
  valor              Decimal         @db.Decimal(12, 2)
  // Situação atual do pagamento.
  situacao           SituacaoParcela @default(PENDENTE)
  // Data opcional em que o pagamento ocorreu.
  pagaEm             DateTime?
  // Identificador opcional e exclusivo do sistema de pagamento externo.
  pagamentoExternoId String?         @unique
  // Tentativas associadas à parcela.
  pagamentos         Pagamento[]

  // Impede parcelas com o mesmo número na mesma obra.
  @@unique([obraId, numero])
  // Permite que Pagamento valide no banco que parcelaId e obraId correspondem.
  @@unique([id, obraId])
  // Acelera consultas de parcelas por obra.
  @@index([obraId])
}

// Mantém cada tentativa financeira até a confirmação oficial do provedor.
model Pagamento {
  // Identificador local enviado como referência externa ao Mercado Pago.
  id                 String          @id @default(uuid())
  // Obra e parcela às quais esta tentativa pertence.
  obraId             String
  obra               Obra            @relation(fields: [obraId], references: [id], onDelete: Restrict)
  parcelaId          String
  // A relação composta impede associar esta tentativa a parcela de outra obra.
  parcela            Parcela         @relation(fields: [parcelaId, obraId], references: [id, obraId], onDelete: Restrict)
  // Cliente autenticado que iniciou o checkout.
  usuarioId          String
  usuario            Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  // Valor reservado para esta tentativa, em reais.
  valor              Decimal         @db.Decimal(12, 2)
  // O estado só muda para aprovado após confirmação consultada no provedor.
  status             StatusPagamento @default(PENDENTE)
  // Chave enviada pelo cliente para repetição segura da mesma solicitação.
  chaveIdempotencia  String          @unique
  // Identificadores externos, protegidos contra associação duplicada.
  pedidoExternoId    String?         @unique
  transacaoExternaId String?         @unique
  // Link HTTPS retornado para o Checkout Pro.
  checkoutUrl        String?
  detalheStatus      String?
  criadoEm           DateTime        @default(now())
  atualizadoEm       DateTime        @updatedAt

  @@index([obraId, status])
  @@index([parcelaId, status])
}

// Guarda os termos de um contrato para uma obra.
model Contrato {
  // Identificador UUID criado automaticamente.
  id        String           @id @default(uuid())
  // Cada obra pode ter no máximo um contrato.
  obraId    String           @unique
  // Relação obrigatória com a obra.
  obra      Obra             @relation(fields: [obraId], references: [id])
  // Empresa que emitiu o contrato.
  empresaId String
  // Relação obrigatória com a empresa.
  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  // Texto integral dos termos contratuais.
  termos    String
  // Data de criação automática do contrato.
  criadoEm  DateTime         @default(now())
  // Aceites registrados para este contrato.
  aceites   ContratoAceite[]

  // Acelera consultas de contratos por empresa.
  @@index([empresaId])
}

// Registra a aceitação de um contrato por um usuário.
model ContratoAceite {
  // Identificador UUID criado automaticamente.
  id         String   @id @default(uuid())
  // Contrato que foi aceito.
  contratoId String
  // Relação obrigatória com o contrato.
  contrato   Contrato @relation(fields: [contratoId], references: [id])
  // Usuário que aceitou os termos.
  usuarioId  String
  // Relação obrigatória com o usuário.
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  // Momento do aceite, preenchido automaticamente.
  aceitoEm   DateTime @default(now())

  // Cada usuário pode aceitar um contrato uma vez.
  @@unique([contratoId, usuarioId])
}

// Define o preço de um serviço da empresa.
model TabelaPreco {
  // Identificador UUID criado automaticamente.
  id        String  @id @default(uuid())
  // Empresa dona deste preço.
  empresaId String
  // Relação obrigatória com a empresa.
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  // Nome do serviço tabelado.
  servico   String
  // Unidade usada para calcular o serviço.
  unidade   String
  // Valor monetário por unidade.
  valor     Decimal @db.Decimal(12, 2)
  // Indica se o preço pode ser usado atualmente.
  ativo     Boolean @default(true)

  // Acelera consultas de preços por empresa.
  @@index([empresaId])
}

// Define os tipos de conta do sistema.
enum TipoUsuario {
  // Conta de cliente.
  CLIENTE
  // Conta de colaborador.
  COLABORADOR
  // Conta de administrador.
  ADMIN
}

enum TipoConvite {
  CLIENTE
  GERENTE
}

// Define o nível de atuação de cada funcionário.
enum NivelFuncionario {
  // Responsável principal pela atividade.
  RESPONSAVEL
  // Profissional de apoio à equipe.
  APOIO
}

// Define os estados possíveis de uma obra.
enum StatusObra {
  // A obra está programada para começar.
  AGENDADA
  // A execução está acontecendo.
  EM_ANDAMENTO
  // A execução terminou e aguarda vistoria.
  AGUARDANDO_CONFERENCIA
  // A obra foi finalizada e aceita.
  CONCLUIDA
}

// Define os estados possíveis de uma parcela.
enum SituacaoParcela {
  // O pagamento ainda está pendente.
  PENDENTE
  // O pagamento foi realizado.
  PAGA
}

// Estados financeiros internos, distintos dos estados do provedor.
enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
  ERRO
}

// Define as categorias disponíveis para eventos.
enum TipoEvento {
  // Registro de contratação.
  CONTRATACAO
  // Aprovação do orçamento.
  ORCAMENTO_APROVADO
  // Registro de agendamento.
  AGENDAMENTO
  // Mudança ou informação de status.
  STATUS
  // Registro de pagamento.
  PAGAMENTO
  // Anotação geral.
  ANOTACAO
  // Atualização do andamento.
  ATUALIZACAO
  // Ocorrência que requer atenção.
  OCORRENCIA
  // Registro de foto.
  FOTO
  // Alteração de equipe.
  EQUIPE
  // Registro de contrato.
  CONTRATO
}
